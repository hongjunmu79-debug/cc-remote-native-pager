# /etc/cc-remote/wrapper.env on the machine where `claude` runs.
# Install root:root mode 0600. Do not keep this token in the repository .env:
# model/tool subprocesses run as your user and can read ordinary user files.
# WRAPPER_TOKEN MUST match the relay's WRAPPER_TOKEN.
# Generate it with `openssl rand -hex 32`; setup-vps.sh rejects values shorter
# than 32 characters on the relay.
RELAY_URL=wss://your-domain.com/ws
# Set to 1 only when RELAY_URL intentionally uses ws:// against a public IP.
# The wrapper token and all session traffic will cross the network unencrypted.
ALLOW_INSECURE_HTTP=0
WRAPPER_TOKEN=REPLACE_WITH_STRONG_WRAPPER_TOKEN
# Stable route id; must match the key in relay WRAPPER_TOKENS_JSON when that
# stricter policy is enabled.
CC_REMOTE_MACHINE_ID=default
# Explicit executable avoids relying on systemd's minimal PATH. Leave blank to
# use the existing PATH discovery behavior.
CLAUDE_BIN=
# Optional per-wrapper Codex upstream proxy; does not change the user's shell.
CC_REMOTE_CODEX_PROXY=
# Code prefers the official shared Codex daemon. Set off only to troubleshoot a
# local daemon incompatibility; Codex Work always remains private stdio.
CC_REMOTE_CODEX_DAEMON=auto
# cwd of the claude session. Must match for --resume to find the session jsonl.
CC_CWD=/path/to/your/project
# Optional Work/Cowork private roots. Omit these two lines to use the defaults.
CLAUDE_WORK_ROOT=/home/youruser/.claude/cc-remote/work
CODEX_WORK_ROOT=/home/youruser/.codex/cc-remote/work
WRAPPER_INBOX_CAP=1024
WRAPPER_SEND_QUEUE_CAP=8192
WRAPPER_INBOX_BYTES=33554432
WRAPPER_SEND_QUEUE_BYTES=33554432
TURN_READER_QUEUE_CAP=4
CODEX_TURN_IDLE_WARN_SECONDS=90
WS_MAX_SIZE_BYTES=16777216
HISTORY_SOURCE_MAX_BYTES=67108864
CODEX_HISTORY_WINDOW_MAX_BYTES=33554432
LOG_LEVEL=INFO
